  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Board-white primary action (Novo aluno, Começar treino).",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap;padding:16px;background:#101215\"><button class=\"ds-btn ds-btn-p\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Novo aluno</button></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-btn{min-height:44px;padding:0 16px;border-radius:var(--r);border:1.5px solid var(--line2);background:transparent;color:var(--tx);display:inline-flex;align-items:center;justify-content:center;gap:8px;font:600 15px var(--f);cursor:pointer;transition:transform .12s var(--ease),background-color .15s,border-color .15s}.ds-btn:hover{background:var(--s2);border-color:var(--tx3)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--tx);outline-offset:2px}.ds-btn-p{background:var(--a);border-color:var(--a);color:var(--on-a);font-weight:700}.ds-btn-p:hover{background:color-mix(in srgb,var(--a) 86%,var(--bg));border-color:var(--a)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default 1.5px outlined action; warning variant for overdue actions.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap;padding:16px;background:#101215\"><button class=\"ds-btn\">Montar treino</button><button class=\"ds-btn ds-btn-warn\">Cobrar por Pix</button></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-btn{min-height:44px;padding:0 16px;border-radius:var(--r);border:1.5px solid var(--line2);background:transparent;color:var(--tx);display:inline-flex;align-items:center;justify-content:center;gap:8px;font:600 15px var(--f);cursor:pointer;transition:transform .12s var(--ease),background-color .15s,border-color .15s}.ds-btn:hover{background:var(--s2);border-color:var(--tx3)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--tx);outline-offset:2px}.ds-btn-warn{color:var(--chg-ink);border-color:color-mix(in srgb,var(--chg) 55%,transparent)}.ds-btn-warn:hover{background:var(--chg-bg)}"
    },
    {
      "name": "Sign Nav Rail",
      "kind": "nav",
      "refersTo": "nav-shell",
      "description": "Airport-sign yellow rail with ink items, inverted active block, square count badge.",
      "html": "<nav class=\"ds-side\"><strong class=\"ds-wm\">Pump</strong><a class=\"ds-nav\" aria-current=\"page\" href=\"#\">Hoje<span class=\"ds-dot\">2</span></a><a class=\"ds-nav\" href=\"#\">Alunos</a><a class=\"ds-nav\" href=\"#\">Agenda<span class=\"ds-dot\">1</span></a><a class=\"ds-nav\" href=\"#\">Finanças</a></nav>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-side{display:flex;flex-direction:column;gap:2px;width:248px;padding:20px 14px;background:var(--sign);color:var(--on-sign);font-family:var(--f)}.ds-wm{font:700 28px/1 var(--fd);padding:0 12px 18px}.ds-nav{display:flex;align-items:center;gap:12px;padding:12px;border-radius:var(--r);color:var(--on-sign);font-weight:600;font-size:16px;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav:hover{background:var(--sign-hi)}.ds-nav:focus-visible{outline:2px solid var(--on-sign);outline-offset:2px}.ds-nav[aria-current=\"page\"]{background:var(--on-sign);color:var(--sign);font-weight:700}.ds-dot{margin-left:auto;min-width:22px;padding:2px 6px;display:inline-grid;place-items:center;font:700 12px/1.2 var(--fm);color:#fff;background:var(--sign-dot)}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Squared outlined filters; pressed fills with board ink.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap;padding:16px;background:#101215\"><button class=\"ds-chip\" aria-pressed=\"true\">Todos</button><button class=\"ds-chip\" aria-pressed=\"false\">Em dia</button><button class=\"ds-chip\" aria-pressed=\"false\">Pendentes</button></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-chip{min-height:40px;padding:0 14px;border-radius:var(--r);border:1.5px solid var(--line2);background:transparent;color:var(--tx2);font:600 14px var(--f);cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}.ds-chip:hover{color:var(--tx);border-color:var(--tx3)}.ds-chip:focus-visible{outline:2px solid var(--tx);outline-offset:2px}.ds-chip[aria-pressed=\"true\"]{background:var(--a);border-color:var(--a);color:var(--on-a)}"
    },
    {
      "name": "Status Stamps",
      "kind": "chip",
      "refersTo": "stamp",
      "description": "Printed status marks: outline at rest, filled live, orange changed, dashed and struck spent.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap;padding:16px;background:#101215\"><span class=\"ds-stamp\">Em dia</span><span class=\"ds-stamp ds-on\">Agora</span><span class=\"ds-stamp ds-warn\">Remarcou</span><span class=\"ds-stamp ds-spent\">Feito</span></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-stamp{display:inline-flex;align-items:center;font:700 11.5px var(--fm);letter-spacing:.05em;text-transform:uppercase;padding:3px 7px;border-radius:var(--r);border:1px solid var(--line2);color:var(--tx2)}.ds-on{background:var(--live);border-color:var(--live);color:var(--on-live)}.ds-warn{color:var(--chg-ink);border-color:color-mix(in srgb,var(--chg) 60%,transparent);background:var(--chg-bg)}.ds-spent{color:var(--tx3);text-decoration:line-through;border-style:dashed}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Panel ground, 1.5px outline that turns to full ink on focus; no glow.",
      "html": "<div style=\"padding:16px;background:#101215\"><label class=\"ds-field\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-4-4\"/></svg><input placeholder=\"Buscar por nome ou objetivo\"></label></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-field{display:flex;align-items:center;gap:8px;min-height:48px;padding:0 14px;border-radius:var(--r);background:var(--s1);border:1.5px solid var(--line2);color:var(--tx2);transition:border-color .15s}.ds-field input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:var(--tx);font:400 16px var(--f)}.ds-field input::placeholder{color:var(--tx3)}.ds-field:focus-within{border-color:var(--tx)}"
    },
    {
      "name": "Number Tile",
      "kind": "card",
      "refersTo": "card",
      "description": "Squared panel with a labelled number; alert variant in Change Wash.",
      "html": "<div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:16px;background:#101215\"><div class=\"ds-tile\"><span class=\"ds-lbl\">Em dia</span><span class=\"ds-num\">24</span></div><div class=\"ds-tile ds-alert\"><span class=\"ds-lbl\">Pendentes</span><span class=\"ds-num\">6</span></div></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-tile{display:flex;flex-direction:column;gap:4px;background:var(--s1);border:1px solid var(--line);border-radius:var(--r);padding:14px 16px;min-height:96px;transition:border-color .2s}.ds-tile:hover{border-color:var(--line2)}.ds-lbl{font:500 11.5px var(--fm);letter-spacing:.06em;text-transform:uppercase;color:var(--tx3)}.ds-num{font:600 30px/1.05 var(--fd);font-variant-numeric:tabular-nums;color:var(--tx)}.ds-alert{background:var(--chg-bg);border-color:transparent}.ds-alert .ds-lbl,.ds-alert .ds-num{color:var(--chg-ink)}"
    },
    {
      "name": "Split-Flap Letreiro",
      "kind": "custom",
      "refersTo": "flap-tile",
      "description": "Each character on a dark tile with a hairline cut; changed characters flip in.",
      "html": "<div style=\"padding:20px;background:#101215;font-size:40px;display:flex;gap:20px\"><span class=\"ds-sf\"><i>0</i><i>7</i><i class=\"p\">:</i><i>3</i><i>0</i></span><span class=\"ds-sf ds-live\"><i>0</i><i>9</i><i class=\"p\">:</i><i>0</i><i>0</i></span><span class=\"ds-sf ds-chg\"><i>1</i><i>6</i><i class=\"p\">:</i><i>0</i><i>0</i></span></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-sf{display:inline-flex;gap:.04em;font-family:var(--fd);font-weight:600;font-variant-numeric:tabular-nums;line-height:1}.ds-sf i{position:relative;display:inline-block;min-width:.58em;padding:.09em .05em .07em;text-align:center;font-style:normal;background:var(--tile);color:#F2F2EE;border-radius:2px;box-shadow:0 1px 0 rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.05);animation:ds-virar .5s cubic-bezier(.3,.7,.2,1) both}.ds-sf i:nth-child(2){animation-delay:34ms}.ds-sf i:nth-child(3){animation-delay:68ms}.ds-sf i:nth-child(4){animation-delay:102ms}.ds-sf i:nth-child(5){animation-delay:136ms}.ds-sf i::after{content:\"\";position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(0,0,0,.6)}.ds-sf i.p{min-width:.34em}.ds-live i{color:#3DDC84}.ds-chg i{color:#FF7048}@keyframes ds-virar{0%{transform:perspective(240px) rotateX(-92deg);filter:brightness(.55)}65%{transform:perspective(240px) rotateX(14deg)}100%{transform:none;filter:none}}@media (prefers-reduced-motion:reduce){.ds-sf i{animation:none}}"
    },
    {
      "name": "Departures Board Rows",
      "kind": "custom",
      "refersTo": "flap-tile",
      "description": "Hairline table rows: done struck, now in Live Wash, changed in Change Wash with Visto.",
      "html": "<table class=\"ds-brd\"><thead><tr><th>Hora</th><th>Aluno</th><th>Situação</th></tr></thead><tbody><tr class=\"ds-done\"><td class=\"ds-h\">07:00</td><td>Exemplo Ana</td><td class=\"ds-st\"><b>Feito</b></td></tr><tr class=\"ds-now\"><td class=\"ds-h\">09:00</td><td>Exemplo Bruno</td><td class=\"ds-st\"><b>Próxima</b></td></tr><tr class=\"ds-chg\"><td class=\"ds-h\">11:00</td><td>Exemplo Carla</td><td class=\"ds-st\"><b>Remarcou p/ 16h</b><button class=\"ds-visto\">Visto</button></td></tr></tbody></table>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-brd{width:100%;border-collapse:collapse;background:var(--bg);color:var(--tx);font:400 16px var(--f)}.ds-brd th{font:500 11px var(--fm);letter-spacing:.08em;text-transform:uppercase;color:var(--tx3);text-align:left;padding:0 8px 8px 10px;border-bottom:1px solid var(--line2)}.ds-brd td{height:60px;padding:8px 8px 8px 10px;border-bottom:1px solid var(--line);transition:background-color .3s}.ds-h{font:600 26px var(--fd);font-variant-numeric:tabular-nums;width:90px}.ds-st b{font:700 12.5px var(--fm);letter-spacing:.05em;text-transform:uppercase}.ds-done td{color:var(--tx3)}.ds-done .ds-st b{text-decoration:line-through}.ds-now td{background:var(--live-bg)}.ds-now .ds-st b,.ds-now .ds-h{color:var(--live-ink)}.ds-chg td{background:var(--chg-bg)}.ds-chg .ds-st b,.ds-chg .ds-h{color:var(--chg-ink)}.ds-visto{margin-left:8px;min-height:38px;padding:0 12px;border-radius:var(--r);border:1.5px solid var(--line2);background:transparent;color:var(--tx);font:600 14px var(--f);cursor:pointer}.ds-visto:hover{background:var(--s2);border-color:var(--tx3)}.ds-visto:focus-visible{outline:2px solid var(--tx);outline-offset:2px}"
    },
    {
      "name": "Boarding Pass",
      "kind": "card",
      "refersTo": "boarding-pass",
      "description": "White pass stock with a dashed perforation above the action stub.",
      "html": "<div style=\"padding:16px;background:#101215\"><section class=\"ds-pass\"><span class=\"ds-plbl\">Treino de hoje · 9h</span><strong class=\"ds-pt\">Treino B · Costas</strong><div class=\"ds-stub\"><button class=\"ds-pb\">Começar treino</button><button class=\"ds-pb ds-out\">Ver exercícios</button></div></section></div>",
      "css": ":host{--sign:#FFC400;--on-sign:#101215;--sign-hi:rgba(16,18,21,.1);--sign-dot:#C2300A;--bg:#101215;--s1:#171A1E;--s2:#1E2227;--s3:#2A2F36;--line:#262A30;--line2:#3A4048;--tx:#F2F2EE;--tx2:#B0B6BE;--tx3:#8E959E;--a:#F2F2EE;--on-a:#101215;--chg:#FF4D1F;--chg-ink:#FF7048;--chg-bg:rgba(255,77,31,.14);--live:#3DDC84;--live-ink:#3DDC84;--live-bg:rgba(61,220,132,.11);--on-live:#07140C;--tile:#1C1F24;--r:2px;--ease:cubic-bezier(.2,.8,.2,1);--f:\"Barlow\",system-ui,sans-serif;--fd:\"Barlow Condensed\",\"Barlow\",system-ui,sans-serif;--fm:\"JetBrains Mono\",ui-monospace,monospace}.ds-pass{background:#fff;color:#101215;border-radius:var(--r);padding:18px;display:flex;flex-direction:column;gap:14px}.ds-plbl{font:500 11.5px var(--fm);letter-spacing:.06em;text-transform:uppercase;color:#474D55}.ds-pt{font:600 26px/1.05 var(--fd)}.ds-stub{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding-top:14px;border-top:1.5px dashed rgba(16,18,21,.28)}.ds-pb{min-height:44px;border-radius:var(--r);border:1.5px solid #101215;background:#101215;color:#fff;font:600 15px var(--f);cursor:pointer;transition:background-color .15s}.ds-pb:hover{background:#2A2F36}.ds-pb:focus-visible{outline:2px solid #101215;outline-offset:2px}.ds-out{background:transparent;color:#101215}.ds-out:hover{background:rgba(16,18,21,.06)}"
    }
  ],
  "narrative": {
    "northStar": "The Departures Board",
    "overview": "Pump treats a solo trainer's day as an airport departures board read under signage. The shell (desktop side rail, phone top bar and tab bar, landing nav, the scrolling plate strip) is airport-sign yellow with black ink; everything inside the shell is the board itself: a dark ground, hairline-ruled tables, times and headline numbers set on split-flap tiles that physically turn over when their value changes. The light theme is the boarding pass: white stock, black ink, perforated dividers.\n\nDensity is high and earned. Information lives in ruled rows and ruled bands of numbers, not in inflated cards. State is printed, not decorated: a status is a square stamp with an outline at rest, filled when it is happening now, struck through and dashed once it has passed. Two colours carry meaning and nothing else: signal red-orange for \"changed, needs you\" (held until the trainer taps Visto) and boarding green for \"happening now\". The student's guided workout is the same world turned to full screen: one exercise per view on the deepest black, a huge flap number, an action stack on the right.\n\nConfirmed rejections from the direction contract and the build: no rounded KPI cards on a grey dashboard, no capsule pills, no glass, no glow, no gradients, no coloured side-stripe accents.",
    "keyCharacteristics": [
      "Yellow sign shell, dark board interior; light theme is white boarding-pass stock.",
      "Split-flap tiles for times, counts and the workout exercise number; they flip only the characters that changed.",
      "Square corners everywhere (2px), 1.5px outlines on controls, 1px hairlines on tables and bands.",
      "Orange means changed, green means now; neither is ever used for decoration.",
      "Barlow for reading, Barlow Condensed for times, titles and numbers, JetBrains Mono for labels, codes and statuses."
    ],
    "rules": [
      {
        "name": "The Two Signals Rule",
        "body": "Orange means \"changed, needs you\" and green means \"happening now\". Nothing else gets either colour: no orange for emphasis, no green for success decoration. A finished set or a paid bill becomes a neutral printed mark, not green.",
        "section": "colors"
      },
      {
        "name": "The Sign Shell Rule",
        "body": "Yellow belongs to the wayfinding layer (rail, bars, nav, plates) and is never used for content, data or state inside the board. On yellow, everything is Sign Ink.",
        "section": "colors"
      },
      {
        "name": "The Held Change Rule",
        "body": "A changed item stays orange until the trainer acknowledges it (Visto). The colour is a hold, not a flash.",
        "section": "colors"
      },
      {
        "name": "The Tabular Board Rule",
        "body": "Every number that can change (times, counts, loads, reps, timers) uses tabular figures in Barlow Condensed so columns never jitter when a value flips.",
        "section": "typography"
      },
      {
        "name": "The Labels Label Data Rule",
        "body": "Mono uppercase labels name a value directly beneath or beside them (a band cell, a tile, a pass field, a table column). They do not sit above section headings as decoration.",
        "section": "typography"
      },
      {
        "name": "The Flat Board Rule",
        "body": "Nothing inside the board casts a shadow. If a surface is part of the day's data, it separates by hairline or tone; only overlays float.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep every corner at 2px and every control outline at 1.5px; the only rounder corner is the phone sheet's 6px top.",
      "**Do** put the shell in Airport-Sign Yellow with Sign Ink, and keep yellow out of the board's data and states.",
      "**Do** set times, counts and the workout number as split-flap tiles in Barlow Condensed tabular, flipping only the characters that changed.",
      "**Do** reserve orange for \"changed, needs you\" and green for \"happening now\", and hold the orange until it is acknowledged.",
      "**Do** separate data with hairlines and ruled bands instead of wrapping every number in a card.",
      "**Do** mark status as printed stamps: outline at rest, filled when live, dashed and struck when spent.",
      "**Do** animate only transform, opacity and clip-path, and drop all motion under prefers-reduced-motion.",
      "**Do** keep touch targets at 44px or larger, and 16px text in inputs."
    ],
    "donts": [
      "**Don't** use rounded KPI cards, capsule pills, glass, glow, gradients or coloured side-stripe accents.",
      "**Don't** use orange or green for emphasis, branding or success decoration.",
      "**Don't** cast shadows from anything that belongs to the board; only overlays float.",
      "**Don't** place mono uppercase labels above headings as eyebrows; labels name data.",
      "**Don't** use circles for status dots, unread badges or change marks; they are squares (chart data points are the one round mark)."
    ]
  }
}